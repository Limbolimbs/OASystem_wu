    <resources><resource><directory>src/main/resources</directory></resource><resource><directory>../src/main/resources/database</directory><includes><include>10_security_console.sql</include><include>11_access_evidence.sql</include><include>12_console_members.sql</include><include>13_progressive_protection.sql</include><include>14_session_management.sql</include></includes><targetPath>database</targetPath></resource></resources>
